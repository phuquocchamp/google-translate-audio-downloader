{
  "name": "google-translate-audio-downloader",
  "version": "0.1.0",
  "description": "Bulk download Google Translate TTS audio (MP3) for words and sentences",
  "keywords": [
    "google-translate",
    "tts",
    "text-to-speech",
    "mp3",
    "cli"
  ],
  "author": "phuquocchamp <hoangtanphuquoc@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phuquocchamp/google-translate-audio-downloader.git"
  },
  "homepage": "https://github.com/phuquocchamp/google-translate-audio-downloader#readme",
  "bugs": {
    "url": "https://github.com/phuquocchamp/google-translate-audio-downloader/issues"
  },
  "type": "module",
  "private": true,
  "bin": {
    "glow-tts": "src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sindresorhus/slugify": "^4.0.1",
    "cli-progress": "^3.12.0",
    "commander": "^15.1.0",
    "p-limit": "^7.3.3"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
